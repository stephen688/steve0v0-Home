.reading-exit {
  display: flex;
  align-items: center;
  width: 100%;
  min-width: 0;
  height: 100%;
  padding: 0 12rpx 0 10rpx;
  border: 1rpx solid rgba(31, 27, 24, 0.18);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 2rpx 6rpx rgba(36, 28, 22, 0.08);
  color: #24211f;
  line-height: 1;
  transition: opacity 160ms ease, transform 160ms ease, box-shadow 160ms ease;
}

.reading-exit::after {
  border: 0;
}

.reading-exit:active {
  opacity: 0.82;
  box-shadow: 0 2rpx 4rpx rgba(36, 28, 22, 0.08);
  transform: translateY(2rpx) scale(0.98);
}

.reading-exit__icon {
  position: relative;
  flex: none;
  width: 24rpx;
  height: 24rpx;
  margin-right: 5rpx;
  border: 1rpx solid #efc89f;
  border-radius: 50%;
  background: #fff3e7;
}

.reading-exit__arrow::before {
  position: absolute;
  top: 10rpx;
  left: 7rpx;
  width: 11rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: #df650d;
  content: '';
}

.reading-exit__arrow::after {
  position: absolute;
  top: 7rpx;
  left: 7rpx;
  width: 6rpx;
  height: 6rpx;
  border-bottom: 2rpx solid #df650d;
  border-left: 2rpx solid #df650d;
  content: '';
  transform: rotate(45deg);
}

.reading-exit__label {
  display: block;
  color: #3d332c;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
