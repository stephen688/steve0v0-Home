.skeleton {
  padding: 24rpx 30rpx;
}

.skeleton__row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 54rpx;
}

.skeleton__dot,
.skeleton__line {
  background: #f1e8df;
}

.skeleton__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.skeleton__line {
  height: 20rpx;
  border-radius: 12rpx;
}

.skeleton__line--long {
  width: 48%;
}

.skeleton__line--short {
  width: 20%;
  margin-left: auto;
}
