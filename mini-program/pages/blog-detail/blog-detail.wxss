.article-page {
  padding-right: 20rpx;
  padding-bottom: 72rpx;
  padding-left: 20rpx;
  background:
    radial-gradient(circle at 94% 13%, rgba(255, 208, 153, 0.18), transparent 28%),
    #fff9f2;
}

.article-nav {
  position: sticky;
  top: 0;
  z-index: 20;
  margin: 0 -20rpx;
  padding: 0;
  background: rgba(255, 249, 242, 0.96);
}

.article-nav__exit {
  position: absolute;
  left: 20rpx;
  display: flex;
  align-items: center;
}

.article-nav__exit reading-exit {
  display: block;
  width: 100%;
  height: 100%;
}

.article-card {
  padding: 32rpx 0 52rpx;
  background: transparent;
}

.article-hero {
  padding-top: 0;
}

.article-title {
  display: block;
  color: #171717;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: -0.8rpx;
  line-height: 1.35;
}

.article-summary {
  display: block;
  margin-top: 16rpx;
  color: #675f58;
  font-size: 28rpx;
  line-height: 1.8;
}

.article-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 24rpx;
  margin-top: 20rpx;
  padding: 0;
  color: #6f6861;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 22rpx;
  line-height: 1.5;
}

.article-meta__item {
  display: inline-flex;
  align-items: center;
}

.article-meta__item:last-child {
  color: #a25a18;
  font-weight: 700;
}

.article-cover {
  display: block;
  width: 100%;
  height: 420rpx;
  margin-top: 32rpx;
  border-radius: 20rpx;
}

.article-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 12rpx;
  margin: 18rpx 0 64rpx;
}

.article-tag {
  display: inline-flex;
  align-items: center;
  min-height: 38rpx;
  padding: 3rpx 16rpx;
  border: 1rpx solid #ead7c2;
  border-radius: 999rpx;
  color: #a15a18;
  background: rgba(249, 239, 226, 0.78);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 22rpx;
  line-height: 30rpx;
}

.article-content {
  display: block;
  color: #24211f;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 32rpx;
  line-height: 2;
}

.markdown-rich {
  display: block;
}

.markdown-h2 {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  color: #1f1f1f;
}

.markdown-h2__bar {
  flex: none;
  width: 6rpx;
  height: 46rpx;
  margin-right: 16rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, #ffb02e 0%, #ff8a00 48%, #ef6500 100%);
}

.markdown-h2__text {
  display: block;
  min-width: 0;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 0;
  line-height: 1.4;
}

.markdown-quote-frame {
  padding: 2rpx 2rpx 2rpx 8rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #ffb02e 0%, #ff8a00 46%, #ef6500 100%);
}

.markdown-quote-card {
  padding: 24rpx 28rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #fffaf3 0%, #fff1df 100%);
}

.markdown-quote-text {
  display: block;
  color: #24211f;
  font-size: 32rpx;
  font-weight: 400;
  letter-spacing: 0.2rpx;
  line-height: 1.8;
}

.markdown-table-frame {
  overflow: hidden;
  padding: 2rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #ffb02e 0%, #ff8a00 48%, #ef6500 100%);
}

.markdown-table {
  overflow: hidden;
  border-radius: 12rpx;
  background: #fffaf3;
}

.markdown-table__row {
  display: flex;
  border-bottom: 1rpx solid #f0d4b4;
  background: linear-gradient(90deg, #fffaf3 0%, #fff5e8 100%);
}

.markdown-table__row:last-child {
  border-bottom: 0;
}

.markdown-table__row--head {
  background: linear-gradient(90deg, #fff1d7 0%, #ffdca8 100%);
}

.markdown-table__cell {
  flex: 1;
  min-width: 0;
  padding: 14rpx 12rpx;
  border-left: 1rpx solid #f0d4b4;
  color: #24211f;
  font-size: 24rpx;
  line-height: 1.55;
  word-break: break-all;
}

.markdown-table__cell:first-child {
  border-left: 0;
}

.markdown-table__cell--head {
  color: #7d430f;
  font-weight: 700;
}
