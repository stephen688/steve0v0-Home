<view class="page-shell page-shell--article article-page">
  <view class="article-nav" style="height:{{navHeight}}px;">
    <view class="article-nav__exit" style="top:{{menuButtonTop}}px;width:{{menuButtonWidth}}px;height:{{menuButtonHeight}}px;">
      <reading-exit label="退出" bind:exit="exitArticle"></reading-exit>
    </view>
  </view>
  <skeleton wx:if="{{loading}}" rows="7"></skeleton>
  <error-state wx:elif="{{error}}" title="文章暂时无法打开" detail="{{errorMessage}}" bind:retry="retry"></error-state>
  <view wx:else class="article-card">
    <view class="article-hero">
      <text class="article-title">{{article.title}}</text>
      <text wx:if="{{article.summary}}" class="article-summary">{{article.summary}}</text>
    </view>
    <view class="article-meta">
      <text class="article-meta__item">▦ {{publishedText}}</text>
      <text class="article-meta__item">⊙ {{article.viewCount || 0}} 阅读</text>
      <text class="article-meta__item">◷ {{article.readTimeMinutes || 1}} 分钟阅读</text>
    </view>
    <image wx:if="{{coverImageUrl}}" class="article-cover" src="{{coverImageUrl}}" mode="aspectFill"></image>
    <view wx:if="{{tagList.length}}" class="article-tags">
      <text wx:for="{{tagList}}" wx:key="*this" class="article-tag">{{item}}</text>
    </view>
    <view class="article-content">
      <block wx:for="{{blocks}}" wx:key="index" wx:for-item="block">
        <view wx:if="{{block.type === 'heading2'}}" class="markdown-h2">
          <view class="markdown-h2__bar"></view>
          <rich-text class="markdown-h2__text" nodes="{{block.nodes}}" bindtap="handleRichTap"></rich-text>
        </view>
        <view wx:elif="{{block.type === 'quote'}}" class="markdown-quote-frame">
          <view class="markdown-quote-card">
            <rich-text class="markdown-quote-text" nodes="{{block.nodes}}" bindtap="handleRichTap"></rich-text>
          </view>
        </view>
        <view wx:elif="{{block.type === 'table'}}" class="markdown-table-frame">
          <view class="markdown-table">
            <view class="markdown-table__row markdown-table__row--head">
              <view wx:for="{{block.headers}}" wx:key="index" wx:for-item="cell" class="markdown-table__cell markdown-table__cell--head">
                <rich-text nodes="{{cell.nodes}}" bindtap="handleRichTap"></rich-text>
              </view>
            </view>
            <view wx:for="{{block.rows}}" wx:key="index" wx:for-item="row" class="markdown-table__row">
              <view wx:for="{{row.cells}}" wx:key="index" wx:for-item="cell" class="markdown-table__cell">
                <rich-text nodes="{{cell.nodes}}" bindtap="handleRichTap"></rich-text>
              </view>
            </view>
          </view>
        </view>
        <rich-text wx:else class="markdown-rich" nodes="{{block.nodes}}" bindtap="handleRichTap"></rich-text>
      </block>
    </view>
  </view>
  <view class="safe-bottom"></view>
</view>
