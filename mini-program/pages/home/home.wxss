.home-greeting {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0 18rpx;
  padding: 10rpx 4rpx 0;
}

.home-greeting__copy {
  min-width: 0;
  flex: 1;
}

.home-greeting__tools {
  display: flex;
  flex: none;
  align-items: flex-start;
}

.home-greeting__title {
  display: block;
  margin-top: 8rpx;
  color: #2d2824;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.35;
  white-space: nowrap;
}

.home-greeting__date {
  display: block;
  flex: 0 0 100%;
  color: #9a8271;
  font-size: 22rpx;
  text-align: right;
}

.calendar-card__head,
.stats-block__heading,
.chart-card__heading,
.home-feed__heading,
.home-feed__subhead,
.detail-sheet__heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stats-block .section-title::before {
  display: none;
}

.status-pet-area {
  position: fixed;
  z-index: 11;
  top: calc(104rpx + env(safe-area-inset-top));
  left: 0;
  width: 100vw;
  height: calc(100vh - 224rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  pointer-events: none;
}

.status-pet {
  width: 188rpx;
  height: 238rpx;
  pointer-events: auto;
}

.status-pet__figure {
  position: relative;
  width: 188rpx;
  height: 160rpx;
  transform-origin: 50% 88%;
  will-change: transform;
}

.status-pet--studying .status-pet__figure {
  animation: status-pet-study 3.4s ease-in-out infinite;
}

.status-pet--exercising .status-pet__figure {
  animation: status-pet-dribble 1.35s ease-in-out infinite;
}

.status-pet__halo {
  position: absolute;
  left: 34rpx;
  bottom: 10rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(229, 238, 233, .72);
}

.status-pet--exercising .status-pet__halo {
  background: rgba(247, 233, 216, .76);
}

.status-pet__student {
  position: absolute;
  z-index: 1;
  bottom: 0;
  left: 50%;
  width: 176rpx;
  height: 156rpx;
  transform: translateX(-50%);
}

.status-pet--exercising .status-pet__student {
  bottom: 0;
  width: 176rpx;
  height: 160rpx;
}

.status-pet__typing {
  position: absolute;
  z-index: 2;
  right: 74rpx;
  bottom: 15rpx;
  display: flex;
  gap: 4rpx;
}

.status-pet__typing text {
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: #6f9587;
  animation: status-pet-typing 1.2s ease-in-out infinite;
}

.status-pet__typing text:nth-child(2) { animation-delay: .14s; }
.status-pet__typing text:nth-child(3) { animation-delay: .28s; }

.status-pet__motion {
  position: absolute;
  z-index: 2;
  right: 13rpx;
  bottom: 29rpx;
}

.status-pet__motion text {
  display: block;
  width: 15rpx;
  height: 3rpx;
  margin-top: 7rpx;
  border-radius: 4rpx;
  background: rgba(193, 105, 38, .48);
  transform: rotate(-18deg);
  animation: status-pet-motion-line 1.35s ease-in-out infinite;
}

.status-pet__motion text:nth-child(2) {
  width: 10rpx;
  margin-left: 4rpx;
  animation-delay: .12s;
}

.status-pet__status {
  box-sizing: border-box;
  width: 176rpx;
  min-height: 70rpx;
  margin: 4rpx auto 0;
  padding: 8rpx 12rpx 9rpx;
  overflow: hidden;
  border: 2rpx solid rgba(218, 226, 220, .92);
  border-radius: 18rpx;
  background: rgba(255, 253, 249, .94);
  box-shadow: 0 7rpx 18rpx rgba(66, 58, 48, .09);
}

.status-pet__state {
  display: flex;
  align-items: center;
  color: #527466;
  font-size: 17rpx;
  font-weight: 800;
  line-height: 1.25;
}

.status-pet__dot {
  width: 7rpx;
  height: 7rpx;
  margin-right: 7rpx;
  border-radius: 50%;
  background: #55a985;
  box-shadow: 0 0 0 4rpx rgba(85, 169, 133, .12);
}

.status-pet--exercising .status-pet__state {
  color: #9b5d2a;
}

.status-pet--exercising .status-pet__dot {
  background: #d17a32;
  box-shadow: 0 0 0 4rpx rgba(209, 122, 50, .13);
}

.status-pet__task {
  display: block;
  margin-top: 4rpx;
  overflow: hidden;
  color: #5f554d;
  font-size: 18rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@keyframes status-pet-study {
  0%, 100% { transform: translate3d(0, 0, 0) rotate(0); }
  45% { transform: translate3d(0, -2rpx, 0) scale(.997); }
  62% { transform: translate3d(1rpx, -1rpx, 0) scale(.999); }
}

@keyframes status-pet-dribble {
  0%, 100% { transform: translate3d(0, 0, 0) rotate(0); }
  45% { transform: translate3d(1rpx, -3rpx, 0) rotate(.35deg); }
  68% { transform: translate3d(-1rpx, -1rpx, 0) rotate(-.15deg); }
}

@keyframes status-pet-typing {
  0%, 55%, 100% { opacity: .25; transform: translateY(0); }
  28% { opacity: .9; transform: translateY(-3rpx); }
}

@keyframes status-pet-motion-line {
  0%, 100% { opacity: .2; transform: translate3d(4rpx, 2rpx, 0) rotate(-18deg); }
  45% { opacity: .75; transform: translate3d(0, 0, 0) rotate(-18deg); }
}

.tomato-launcher {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  min-height: 112rpx;
  overflow: visible;
  background: transparent;
}

.tomato-launcher__plate {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border: 2rpx solid #ead7c7;
  border-radius: 50%;
  background: #fffaf4;
  box-shadow: 0 9rpx 20rpx rgba(86, 48, 26, .13);
}

.tomato-mini {
  position: relative;
  width: 64rpx;
  height: 64rpx;
}

.tomato-mini__body {
  position: absolute;
  right: 3rpx;
  bottom: 2rpx;
  left: 3rpx;
  height: 51rpx;
  border-radius: 48% 48% 44% 44% / 45% 45% 54% 54%;
  background: #e9563f;
  box-shadow: inset 0 -6rpx 0 rgba(157, 49, 35, .14);
}

.tomato-mini__shine {
  width: 11rpx;
  height: 17rpx;
  margin: 9rpx 0 0 12rpx;
  border-radius: 50%;
  background: rgba(255, 240, 224, .72);
  transform: rotate(32deg);
}

.tomato-mini__stem {
  position: absolute;
  z-index: 2;
  top: -2rpx;
  left: 30rpx;
  width: 7rpx;
  height: 19rpx;
  border-radius: 8rpx;
  background: #397d51;
  transform: rotate(8deg);
}

.tomato-mini__leaf {
  position: absolute;
  z-index: 2;
  top: 10rpx;
  width: 27rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #4b9461;
}

.tomato-mini__leaf--left {
  left: 9rpx;
  transform: rotate(18deg);
}

.tomato-mini__leaf--right {
  right: 8rpx;
  transform: rotate(-20deg);
}

.tomato-launcher__state {
  position: absolute;
  right: -1rpx;
  bottom: 3rpx;
  width: 17rpx;
  height: 17rpx;
  border: 4rpx solid #fffaf4;
  border-radius: 50%;
  background: #cbb9aa;
}

.tomato-launcher__label {
  margin-top: 4rpx;
  color: #a05b42;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 1.2;
}

.tomato-launcher--running .tomato-launcher__state {
  background: #43845b;
}

.tomato-launcher--completed .tomato-launcher__state {
  background: #f3a847;
}

.tomato-launcher--running .tomato-mini {
  animation: tomato-working 1800ms ease-in-out infinite;
}

@keyframes tomato-working {
  0%, 100% { transform: rotate(-3deg); }
  50% { transform: rotate(3deg); }
}

.pomodoro-modal__mask {
  position: fixed;
  z-index: 40;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(45, 32, 25, .48);
}

.pomodoro-modal {
  width: 100%;
  max-height: 91vh;
  padding: 14rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  border-radius: 38rpx 38rpx 0 0;
  background: #fff9f1;
  box-shadow: 0 -18rpx 48rpx rgba(49, 29, 21, .18);
}

.pomodoro-modal__handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 22rpx;
  border-radius: 8rpx;
  background: #dfd0c4;
}

.pomodoro-modal__head,
.pomodoro-settings__head,
.pomodoro-settings__task-row,
.pomodoro-settings__duration-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pomodoro-modal__head {
  gap: 20rpx;
}

.pomodoro-modal__head > view {
  min-width: 0;
  flex: 1;
}

.pomodoro-modal__title {
  display: block;
  margin-top: 4rpx;
  color: #342b27;
  font-size: 29rpx;
  font-weight: 800;
}

.pomodoro-modal__close {
  flex: 0 0 46rpx;
  width: 46rpx;
  min-width: 46rpx;
  max-width: 46rpx;
  height: 46rpx;
  min-height: 46rpx;
  border: 2rpx solid #eadfd6;
  border-radius: 50%;
  color: #856f61;
  font-size: 27rpx;
  line-height: 42rpx;
  text-align: center;
}

.pomodoro-modal__close text {
  display: block;
  line-height: 42rpx;
}

.pomodoro-modes {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 6rpx;
  border-radius: 24rpx;
  background: #efe6dd;
}

.pomodoro-modes__item {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  min-height: 68rpx;
  padding: 10rpx 4rpx;
  border-radius: 18rpx;
  color: #78685d;
  font-size: 23rpx;
  line-height: 1.25;
  text-align: center;
}

.pomodoro-modes__item text {
  display: block;
}

.pomodoro-modes__time {
  margin-top: 3rpx;
  color: #aa9587;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 18rpx;
}

.pomodoro-modes__item--active {
  background: #fffaf4;
  box-shadow: 0 5rpx 12rpx rgba(91, 62, 42, .09);
  color: #bd4934;
  font-weight: 700;
}

.pomodoro-modes__item--active .pomodoro-modes__time {
  color: #ce7969;
}

.pomodoro-dial-wrap {
  display: flex;
  justify-content: center;
  padding: 50rpx 0 16rpx;
}

.pomodoro-dial {
  position: relative;
  width: 376rpx;
  height: 376rpx;
  border: 10rpx solid #c74734;
  border-radius: 51% 51% 47% 47% / 49% 49% 53% 53%;
  background: #e95b43;
  box-shadow: 0 18rpx 32rpx rgba(151, 57, 40, .20), inset 0 -12rpx 0 rgba(153, 49, 35, .12);
  transition: box-shadow 180ms ease, transform 180ms ease;
}

.pomodoro-dial--running {
  animation: pomodoro-dial-breathe 2.4s ease-in-out infinite;
}

@keyframes pomodoro-dial-breathe {
  0%, 100% { box-shadow: 0 18rpx 32rpx rgba(151, 57, 40, .20), 0 0 0 0 rgba(226, 86, 64, 0), inset 0 -12rpx 0 rgba(153, 49, 35, .12); }
  50% { box-shadow: 0 20rpx 38rpx rgba(151, 57, 40, .26), 0 0 0 10rpx rgba(226, 86, 64, .08), inset 0 -12rpx 0 rgba(153, 49, 35, .12); }
}

.pomodoro-dial__leaves {
  position: absolute;
  z-index: 4;
  top: -38rpx;
  left: 50%;
  width: 138rpx;
  height: 58rpx;
  transform: translateX(-50%);
}

.pomodoro-dial__stem {
  position: absolute;
  top: -8rpx;
  left: 66rpx;
  width: 12rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: #357249;
  transform: rotate(7deg);
}

.pomodoro-dial__leaf {
  position: absolute;
  top: 25rpx;
  left: 50%;
  width: 68rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #47875a;
  transform-origin: 0 50%;
}

.pomodoro-dial__leaf--one { transform: rotate(8deg); }
.pomodoro-dial__leaf--two { transform: rotate(132deg); }
.pomodoro-dial__leaf--three { transform: rotate(224deg); }

.pomodoro-dial__tick {
  position: absolute;
  z-index: 1;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.pomodoro-dial__tick-line {
  position: absolute;
  top: 18rpx;
  left: 50%;
  width: 3rpx;
  height: 11rpx;
  border-radius: 3rpx;
  background: rgba(113, 37, 27, .24);
  transform: translateX(-50%);
}

.pomodoro-dial__tick--major .pomodoro-dial__tick-line {
  width: 5rpx;
  height: 18rpx;
}

.pomodoro-dial__tick--active .pomodoro-dial__tick-line {
  background: #fff2df;
}

.pomodoro-dial__core {
  position: absolute;
  z-index: 2;
  top: 50%;
  left: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 264rpx;
  height: 264rpx;
  padding: 24rpx;
  border: 4rpx solid rgba(151, 54, 40, .18);
  border-radius: 50%;
  background: #fff9ef;
  box-shadow: inset 0 5rpx 12rpx rgba(105, 65, 43, .07);
  transform: translate(-50%, -50%);
  text-align: center;
}

.pomodoro-dial__phase {
  color: #a26858;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.pomodoro-dial__time {
  margin-top: 8rpx;
  color: #913a2d;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 64rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  line-height: 1.08;
}

.pomodoro-dial__task {
  display: -webkit-box;
  max-width: 210rpx;
  margin-top: 8rpx;
  overflow: hidden;
  color: #826e62;
  font-size: 19rpx;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}

.pomodoro-dial__tap-hint {
  display: block;
  margin-top: 8rpx;
  color: #b49282;
  font-size: 16rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.pomodoro-cycle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.pomodoro-cycle__label {
  color: #76665c;
  font-size: 22rpx;
  font-weight: 700;
}

.pomodoro-cycle__dots {
  display: flex;
  gap: 10rpx;
}

.pomodoro-cycle__dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 31rpx;
  height: 31rpx;
  border: 2rpx solid #ddcec2;
  border-radius: 50%;
  background: #fffaf4;
  color: #ac998c;
  font-size: 17rpx;
}

.pomodoro-cycle__dot--current {
  border-color: #e25640;
  color: #c94d38;
  box-shadow: 0 0 0 5rpx rgba(226, 86, 64, .10);
}

.pomodoro-cycle__dot--done {
  border-color: #44825a;
  background: #44825a;
  color: #fff;
}

.pomodoro-actions {
  display: grid;
  grid-template-columns: 96rpx minmax(0, 1fr) 96rpx;
  gap: 12rpx;
  margin-top: 24rpx;
}

.pomodoro-actions__round,
.pomodoro-actions__primary {
  height: 72rpx;
  border-radius: 22rpx;
  text-align: center;
}

.pomodoro-actions__round {
  width: 96rpx;
  min-width: 96rpx;
  max-width: 96rpx;
  border: 2rpx solid #dfcec1;
  background: rgba(255, 253, 249, .72);
  color: #9b7364;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 68rpx;
}

.pomodoro-actions__primary {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  background: #c94f39;
  color: #fffaf4;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 72rpx;
  letter-spacing: 2rpx;
}

.pomodoro-settings {
  margin-top: 24rpx;
  padding: 24rpx;
  border: 2rpx solid #eadfd6;
  border-radius: 24rpx;
  background: rgba(255, 253, 249, .94);
  box-shadow: 0 10rpx 24rpx rgba(89, 61, 42, .055);
}

.pomodoro-settings__head {
  gap: 18rpx;
}

.pomodoro-settings__head > view {
  min-width: 0;
  flex: 1;
}

.pomodoro-settings__title {
  display: block;
  color: #3f3530;
  font-size: 25rpx;
  font-weight: 800;
}

.pomodoro-settings__summary {
  display: block;
  margin-top: 2rpx;
  color: #a18d80;
  font-size: 18rpx;
}

.pomodoro-settings__save {
  flex: 0 0 128rpx;
  width: 128rpx;
  min-width: 128rpx;
  max-width: 128rpx;
  height: 52rpx;
  border: 2rpx solid #ead4c8;
  border-radius: 16rpx;
  background: #fff8f2;
  color: #bf4c37;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 48rpx;
}

.pomodoro-settings__task-row,
.pomodoro-settings__duration-row {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  margin-top: 22rpx;
  gap: 10rpx;
}

.pomodoro-settings__field-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.pomodoro-settings__label {
  flex: none;
  color: #65574f;
  font-size: 22rpx;
  font-weight: 700;
}

.pomodoro-settings__note {
  display: block;
  margin-top: 0;
  color: #ad9a8d;
  font-size: 18rpx;
}

.pomodoro-settings__task {
  width: 100%;
  min-width: 0;
  height: 66rpx;
  padding: 0 20rpx;
  border: 2rpx solid #e5d8ce;
  border-radius: 17rpx;
  background: #fffaf5;
  color: #4a3d36;
  font-size: 22rpx;
  box-shadow: inset 0 2rpx 5rpx rgba(91, 61, 42, .025);
}

.pomodoro-stepper {
  display: flex;
  align-items: center;
  width: 100%;
  height: 66rpx;
  overflow: hidden;
  border: 2rpx solid #e3d5ca;
  border-radius: 17rpx;
  background: #fffaf5;
  box-shadow: inset 0 2rpx 5rpx rgba(91, 61, 42, .025);
}

.pomodoro-stepper__button {
  flex: 0 0 68rpx;
  width: 68rpx;
  min-width: 68rpx;
  max-width: 68rpx;
  height: 62rpx;
  color: #ba4b37;
  font-size: 27rpx;
  line-height: 62rpx;
  text-align: center;
}

.pomodoro-stepper__button:first-child {
  border-right: 2rpx solid #eee2d9;
}

.pomodoro-stepper__button:last-child {
  border-left: 2rpx solid #eee2d9;
}

.pomodoro-stepper__input {
  min-width: 0;
  flex: 1;
  width: auto;
  height: 62rpx;
  color: #4e4039;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
}

.pomodoro-stepper__unit {
  flex: none;
  padding: 0 12rpx 0 0;
  color: #9e887a;
  font-size: 19rpx;
}

.pomodoro-presets {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 14rpx;
}

.pomodoro-presets__item {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  min-height: 64rpx;
  padding: 7rpx 4rpx;
  border: 2rpx solid #eadfd6;
  border-radius: 16rpx;
  background: #fffaf5;
  color: #8a7568;
  line-height: 1.12;
  text-align: center;
}

.pomodoro-presets__item text {
  display: block;
}

.pomodoro-presets__value {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 20rpx;
  font-weight: 800;
}

.pomodoro-presets__label {
  margin-top: 3rpx;
  color: #aa978a;
  font-size: 16rpx;
}

.pomodoro-presets__item--active {
  border-color: #d86752;
  background: #fff1e8;
  color: #b84231;
  box-shadow: 0 4rpx 12rpx rgba(183, 68, 48, .08);
}

.pomodoro-presets__item--active .pomodoro-presets__label {
  color: #c06b5b;
}

.pomodoro-settings button[disabled],
.pomodoro-settings input[disabled] {
  opacity: .5;
}

.pomodoro-modal__hint {
  display: block;
  margin-top: 18rpx;
  color: #9d887b;
  font-size: 19rpx;
  text-align: center;
}

@media (prefers-reduced-motion: reduce) {
  .status-pet__figure,
  .status-pet__typing text,
  .status-pet__motion text,
  .tomato-launcher--running .tomato-mini,
  .pomodoro-dial--running {
    animation: none;
  }
}

.calendar-card__head .section-title {
  margin-top: 6rpx;
}

.calendar-card__caption {
  display: block;
  margin-top: 4rpx;
  color: #9b8777;
  font-size: 21rpx;
}

.calendar-card__switch {
  width: 156rpx;
}

.segmented--small {
  padding: 4rpx;
}

.segmented--small .segmented__item {
  min-height: 48rpx;
  font-size: 22rpx;
  line-height: 48rpx;
}

.calendar-card__nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
}

.calendar-card__title {
  color: #3c342e;
  font-size: 27rpx;
  font-weight: 700;
}

.calendar-card__arrow {
  flex: 0 0 54rpx;
  width: 54rpx;
  min-width: 54rpx;
  max-width: 54rpx;
  height: 54rpx;
  border: 2rpx solid #eee5db;
  border-radius: 50%;
  color: #af6321;
  font-size: 44rpx;
  line-height: 45rpx;
  text-align: center;
}

.calendar-overview {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 20rpx;
  border: 2rpx solid #eee5db;
  border-radius: 18rpx;
  background: #fcfaf7;
}

.calendar-overview__item {
  min-width: 0;
  padding: 16rpx 8rpx 14rpx;
  text-align: center;
}

.calendar-overview__item + .calendar-overview__item {
  border-left: 2rpx solid #eee5db;
}

.calendar-overview__value,
.calendar-overview__label {
  display: block;
}

.calendar-overview__value {
  overflow: hidden;
  color: #453b34;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.calendar-overview__value--record { color: #b45b12; }
.calendar-overview__value--course { color: #6872bd; }

.calendar-overview__label {
  margin-top: 4rpx;
  color: #9c8979;
  font-size: 19rpx;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  margin-top: 20rpx;
}

.calendar-grid__weekday {
  color: #ad9784;
  font-size: 21rpx;
  text-align: center;
}

.calendar-day {
  position: relative;
  min-width: 0;
  min-height: 94rpx;
  padding: 9rpx 5rpx 7rpx;
  border: 2rpx solid transparent;
  border-radius: 14rpx;
  background: #fdfbf8;
}

.calendar-day--muted {
  opacity: .32;
}

.calendar-day--today {
  background: #fff4e7;
}

.calendar-day--selected {
  border-color: #d77a2e;
  box-shadow: 0 4rpx 12rpx rgba(169, 91, 26, .1);
}

.calendar-day--load-1 { background: #fdf8f2; }
.calendar-day--load-2 { background: #fbf1e7; }
.calendar-day--load-3 { background: #f7e8da; }

.calendar-day__date {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 3rpx;
}

.calendar-day__number {
  color: #58483c;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.25;
}

.calendar-day__today-label {
  color: #b45b12;
  font-size: 15rpx;
  font-weight: 800;
}

.calendar-day__facts {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 43rpx;
  margin-top: 3rpx;
}

.calendar-day__fact {
  display: block;
  overflow: hidden;
  max-width: 100%;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.calendar-day__fact--record { color: #b45b12; }
.calendar-day__fact--course { color: #6872bd; }

.calendar-day__empty {
  color: #d9cec4;
  font-size: 20rpx;
}

.calendar-card__legend {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 18rpx;
  color: #a18c7b;
  font-size: 19rpx;
}

.calendar-card__legend text {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-line {
  display: inline-block;
  width: 22rpx;
  height: 5rpx;
  border-radius: 5rpx;
}

.legend-line--record { background: #d77a2e; }
.legend-line--course { background: #7580c8; }

.calendar-card__legend-note {
  margin-left: auto;
  color: #b1a092;
}

.calendar-agenda {
  margin-top: 22rpx;
  padding: 20rpx;
  border: 2rpx solid #ede3d9;
  border-radius: 20rpx;
  background: #fffdf9;
}

.calendar-agenda__head,
.calendar-agenda__row,
.calendar-agenda__footer {
  display: flex;
  align-items: center;
}

.calendar-agenda__head,
.calendar-agenda__footer {
  justify-content: space-between;
}

.calendar-agenda__kicker,
.calendar-agenda__date,
.calendar-agenda__title,
.calendar-agenda__meta,
.calendar-agenda__empty-title,
.calendar-agenda__empty-copy {
  display: block;
}

.calendar-agenda__kicker {
  color: #ae7550;
  font-size: 16rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.calendar-agenda__date {
  margin-top: 2rpx;
  color: #403730;
  font-size: 25rpx;
  font-weight: 800;
}

.calendar-agenda__count {
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: #f4eee7;
  color: #806b5c;
  font-size: 19rpx;
}

.calendar-agenda__list {
  margin-top: 14rpx;
  border-top: 2rpx solid #eee5db;
}

.calendar-agenda__row {
  gap: 14rpx;
  min-height: 76rpx;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #f1e9e1;
}

.calendar-agenda__type {
  flex: 0 0 auto;
  width: 58rpx;
  padding: 3rpx 0;
  border-radius: 8rpx;
  font-size: 18rpx;
  font-weight: 800;
  text-align: center;
}

.calendar-agenda__type--record {
  background: #fff0e2;
  color: #ae5a18;
}

.calendar-agenda__type--course {
  background: #eef0ff;
  color: #616bb4;
}

.calendar-agenda__content {
  min-width: 0;
}

.calendar-agenda__title,
.calendar-agenda__meta {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.calendar-agenda__title {
  color: #4a4038;
  font-size: 23rpx;
  font-weight: 700;
}

.calendar-agenda__meta {
  margin-top: 2rpx;
  color: #9d8978;
  font-size: 19rpx;
}

.calendar-agenda__footer {
  gap: 12rpx;
  padding-top: 14rpx;
  color: #9a8778;
  font-size: 19rpx;
}

.calendar-agenda__more {
  flex: 0 0 auto;
  color: #b45b12;
  font-weight: 700;
}

.calendar-agenda__empty {
  padding: 22rpx 0 4rpx;
}

.calendar-agenda__empty-title {
  color: #5e5046;
  font-size: 23rpx;
  font-weight: 700;
}

.calendar-agenda__empty-copy {
  margin-top: 3rpx;
  color: #a18d7c;
  font-size: 20rpx;
}

.stats-block__heading {
  align-items: flex-end;
  padding: 0 4rpx;
}

.stats-block__heading .muted {
  font-size: 21rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 18rpx;
}

.stats-tile {
  padding: 24rpx;
}

.stats-tile__label,
.stats-tile__unit {
  display: block;
  color: #927d6b;
  font-size: 22rpx;
}

.stats-tile__value {
  display: inline-block;
  margin-top: 6rpx;
  color: #bf5f12;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.1;
}

.stats-tile__unit {
  display: inline-block;
  margin-left: 8rpx;
}

.chart-card,
.heatmap-card {
  padding: 28rpx 30rpx;
}

.chart-card__heading .section-title::before {
  display: none;
}

.bar-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 220rpx;
  margin-top: 26rpx;
  padding: 0 8rpx;
  border-bottom: 2rpx solid rgba(125, 182, 191, .25);
}

.bar-chart__item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
}

.bar-chart__value {
  color: #468d9b;
  font-size: 20rpx;
}

.bar-chart__bar {
  width: 28rpx;
  min-height: 12rpx;
  margin: 8rpx 0;
  border-radius: 16rpx 16rpx 0 0;
  background: #75c4ca;
}

.bar-chart__label {
  color: #8aa3a1;
  font-size: 19rpx;
}

.heatmap {
  display: grid;
  grid-template-columns: repeat(10, 1fr);
  gap: 8rpx;
  margin-top: 24rpx;
}

.heatmap__cell {
  width: 100%;
  padding-bottom: 100%;
  border-radius: 6rpx;
  background: #f1eee9;
}

.heatmap__cell--1 { background: #f3d7bb; }
.heatmap__cell--2 { background: #f1b77e; }
.heatmap__cell--3 { background: #e98942; }
.heatmap__cell--4 { background: #bc5c1c; }

.home-feed__heading {
  margin-bottom: 18rpx;
}

.home-feed__section + .home-feed__section {
  margin-top: 28rpx;
}

.home-feed__subhead {
  margin-bottom: 14rpx;
  padding: 0 4rpx;
  color: #564940;
  font-size: 27rpx;
  font-weight: 700;
}

article-card,
moment-card {
  display: block;
  margin-top: 16rpx;
}

.detail-sheet__mask {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(39, 31, 25, .32);
}

.detail-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  max-height: 78vh;
  padding: 16rpx 32rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #fff9f2;
}

.detail-sheet__handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  border-radius: 8rpx;
  background: #e4d5c8;
}

.detail-sheet__heading .section-title {
  margin-top: 8rpx;
}

.detail-sheet__close {
  color: #8e7766;
  font-size: 44rpx;
}

.detail-sheet__group {
  margin-top: 24rpx;
}

.detail-sheet__label {
  display: block;
  margin-bottom: 10rpx;
  color: #a75d1a;
  font-size: 23rpx;
  font-weight: 700;
}

.detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #eee5db;
  color: #4b4038;
  font-size: 25rpx;
}

.detail-row__sub {
  display: block;
  margin-top: 2rpx;
  color: #a18b79;
  font-size: 21rpx;
}
